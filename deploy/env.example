DATABASE_URL=sqlite:////opt/seek-hunter/data/seekhunter.db
DATA_DIR=/opt/seek-hunter/data
LATEX_DIR=/opt/seek-hunter/book-cv/latex
RESUME_DIR=/opt/seek-hunter/book-cv/latex/sections/resume
TECTONIC_BIN=/usr/local/bin/tectonic
STATIC_DIR=/opt/seek-hunter/app/frontend/dist
PUBLIC_URL=https://seekhunter.bookmountain.work
TELEGRAM_TARGET=1635495359
OPENCLAW_BIN=/usr/bin/openclaw
OPENCLAW_AGENT=seekhunter-scorer
ALLOWED_CIDRS=127.0.0.1/32,192.168.4.0/24,100.64.0.0/10
# Only used for tunnel traffic while login is disabled (AUTH_USERNAME empty).
ALLOWED_PUBLIC_IPS=180.150.112.113,2403:5818:747c::/48
TUNNEL_PROXY_IPS=192.168.4.106
API_WRITE_TOKEN=change-me
WRITE_REQUIRES_TOKEN=false
ANTHROPIC_API_KEY=
RM_BASE_URL=http://192.168.4.106:3100
# Login for requests arriving through the Cloudflare tunnel (LAN/Tailscale/localhost stay open).
# Leave AUTH_USERNAME empty to disable login. Never commit real values.
#   AUTH_PASSWORD_HASH: run `uv run seekhunter hash-password` and paste the single scrypt$... line
#   SESSION_SECRET:     run `openssl rand -hex 32` (changing it signs every browser out)
# The app refuses to start if AUTH_USERNAME is set but either of these is missing or weak.
AUTH_USERNAME=book
AUTH_PASSWORD_HASH=
SESSION_SECRET=
