[Unit]
Description=SeekHunter Company Radar poll (employer ATS feeds)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/seek-hunter/app/backend
EnvironmentFile=/opt/seek-hunter/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.local/bin/uv run --frozen --no-dev seekhunter radar
# 75 = the previous radar run is still going
SuccessExitStatus=75
TimeoutStartSec=25min
MemoryMax=500M
